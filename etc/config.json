{
  "gemini": {
    "enabled": true,
    "model": "gemini-3.8-flash"
  },

  "email": {
    "smtp_host": "smtp.example.com",
    "smtp_port": 587,
    "starttls": true,
    "username": "",
    "password": "",
    "sender": "security-alert@example.com",
    "recipient": "admin@example.com"
  },

  "alerting": {
    "cooldown_seconds": 300
  },

  "logs": {
    "audit_log": "/var/log/audit/audit.log",
    "secure_log": "/var/log/secure"
  },

  "intervals": {
    "state_check_seconds": 30,
    "permission_scan_seconds": 900
  },

  "network": {
    "allowed_listening_ports": [
      "tcp/22",
      "tcp/80",
      "tcp/443"
    ]
  },

  "auth_monitor": {
    "window_seconds": 300,
    "failure_threshold": 5
  },

  "permission_monitor": {
    "paths": [
      "/etc",
      "/usr/bin",
      "/usr/sbin",
      "/root",
      "/var/www"
    ]
  },

  "storage": {
    "monitor_directories": [
      "/var/www",
      "/opt"
    ],
    "disk_usage_alert_percent": 85,
    "disk_usage_spike_percent": 15,
    "allowed_mounts": [],
    "required_mount_options": {
      "/data": [
        "nodev",
        "nosuid"
      ]
    }
  }
}